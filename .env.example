# HireSwipe — Environment Variables Example
# Copy this to .env and fill in your own values.
# NEVER commit a .env file with real secrets to version control.
# NEVER put SUPABASE_SERVICE_ROLE_KEY into frontend/Angular code.

SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key

# Service role key (backend/server-side ONLY — never in Angular)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
