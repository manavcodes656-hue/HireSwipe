# HireSwipe backend — environment variables (placeholders only)
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is gitignored. NEVER commit real secrets.

# Port the API listens on (defaults to 3000)
PORT=3000

# development | production
NODE_ENV=development

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGIN=http://localhost:4200

# Supabase project URL
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Publishable (anon) key — the same public key the Angular app uses. The API
# combines it with each caller's access token so RLS applies to their requests.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Service role key — server-side ONLY, bypasses RLS. NEVER expose it to Angular,
# API responses or logs.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
