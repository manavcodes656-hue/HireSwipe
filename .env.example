# HireSwipe — Environment Variables Example
# Copy this to .env in the repo root (server/load-env.js loads it) and fill in your own values.
# NEVER commit a .env file with real secrets to version control.
# NEVER put SUPABASE_SERVICE_ROLE_KEY into frontend/Angular code.
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Environment configuration
NODE_ENV=development

# Server configuration
PORT=3000
CORS_ORIGIN=http://localhost:4200

# POST /api/company/applications/:applicationId/interest needs public.company_interest
# (migration 006). Keep false until the matching change (migration 007) is verified and applied.
COMPANY_INTEREST_ENABLED=false
