# HireSwipe backend — environment variables (placeholders only)
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is gitignored. NEVER commit real secrets.

# Port the API listens on (defaults to 3000)
PORT=3000

# development | production
NODE_ENV=development

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGIN=http://localhost:4200

# Supabase — server-side only. NEVER expose these to Angular.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
